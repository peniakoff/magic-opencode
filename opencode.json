{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "subagent_depth": 1,
  "share": "disabled",
  "lsp": true,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.80",
        "--isolated",
        "--output-dir",
        ".artifacts/playwright"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 30000,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      }
    }
  },
  "permission": {
    "playwright_*": "deny",
    "context7_*": "deny"
  },
  "watcher": {
    "ignore": [
      ".artifacts/**"
    ]
  }
}